{
    "name": "borealis-bond-protocol",
    "version": "1.0.0",
    "private": true,
    "description": "Protocolo TypeScript de bonos, vesting, reservas, emision y control de riesgo.",
    "type": "module",
    "scripts": {
        "build": "tsc --noEmit",
        "test": "npm run build && node --import tsx --test \"tests/node/*.test.ts\" \"tests/repository/*.test.ts\" \"sdk/*.test.ts\"",
        "test:ts": "node --import tsx --test \"tests/node/*.test.ts\" \"sdk/*.test.ts\"",
        "ci": "npm run format:check && npm test && npm run verify:repo",
        "fmt": "prettier --config .prettierrc --ignore-path .prettierignore --write .",
        "format:check": "prettier --check .",
        "verify:repo": "node scripts/verify-repository.mjs",
        "loc": "node scripts/check-loc.mjs"
    },
    "devDependencies": {
        "@types/node": "24.13.3",
        "prettier": "3.9.6",
        "tsx": "4.23.0",
        "typescript": "5.9.3"
    },
    "engines": {
        "bun": ">=1.3.14",
        "node": ">=24"
    }
}
